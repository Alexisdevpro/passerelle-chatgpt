  "components": {
    "schemas": {
      "ChatImage": {
        "properties": {
          "type": {
            "type": "string",
            "const": "image_url",
            "title": "Type"
          },
          "image_url": {
            "$ref": "#/components/schemas/ChatImageURL"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "type",
          "image_url"
        ],
        "title": "ChatImage"
      },
      "ChatImageURL": {
        "properties": {
          "url": {
            "type": "string",
            "title": "Url",
            "description": "URL HTTPS ou data URL base64 d'une photo. Même contenu que Responses input_image.image_url."
          },
          "detail": {
            "type": "string",
            "enum": [
              "auto",
              "low",
              "high",
              "original"
            ],
            "title": "Detail",
            "default": "auto"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "url"
        ],
        "title": "ChatImageURL"
      },
      "ChatMessage": {
        "properties": {
          "role": {
            "type": "string",
            "enum": [
              "system",
              "developer",
              "user",
              "assistant"
            ],
            "title": "Role"
          },
          "content": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "items": {
                  "oneOf": [
                    {
                      "$ref": "#/components/schemas/ChatText"
                    },
                    {
                      "$ref": "#/components/schemas/ChatImage"
                    }
                  ],
                  "discriminator": {
                    "propertyName": "type",
                    "mapping": {
                      "image_url": "#/components/schemas/ChatImage",
                      "text": "#/components/schemas/ChatText"
                    }
                  }
                },
                "type": "array"
              }
            ],
            "title": "Content"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "role",
          "content"
        ],
        "title": "ChatMessage"
      },
      "ChatRequest": {
        "properties": {
          "model": {
            "type": "string",
            "maxLength": 200,
            "minLength": 1,
            "title": "Model"
          },
          "messages": {
            "items": {
              "$ref": "#/components/schemas/ChatMessage"
            },
            "type": "array",
            "minItems": 1,
            "title": "Messages"
          },
          "stream": {
            "type": "boolean",
            "title": "Stream",
            "default": false
          },
          "stream_options": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/StreamOptions"
              },
              {
                "type": "null"
              }
            ]
          },
          "store": {
            "type": "boolean",
            "const": false,
            "title": "Store",
            "default": false
          },
          "n": {
            "type": "integer",
            "const": 1,
            "title": "N",
            "default": 1
          },
          "temperature": {
            "anyOf": [
              {
                "anyOf": [
                  {
                    "type": "number"
                  },
                  {
                    "type": "integer"
                  }
                ],
                "ge": 0,
                "le": 2
              },
              {
                "type": "null"
              }
            ],
            "title": "Temperature"
          },
          "top_p": {
            "anyOf": [
              {
                "anyOf": [
                  {
                    "type": "number"
                  },
                  {
                    "type": "integer"
                  }
                ],
                "ge": 0,
                "le": 1
              },
              {
                "type": "null"
              }
            ],
            "title": "Top P"
          },
          "max_tokens": {
            "anyOf": [
              {
                "type": "integer",
                "maximum": 131072.0,
                "minimum": 1.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Max Tokens"
          },
          "max_completion_tokens": {
            "anyOf": [
              {
                "type": "integer",
                "maximum": 131072.0,
                "minimum": 1.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Max Completion Tokens"
          },
          "reasoning_effort": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "none",
                  "minimal",
                  "low",
                  "medium",
                  "high",
                  "xhigh",
                  "max"
                ]
              },
              {
                "type": "null"
              }
            ],
            "title": "Reasoning Effort"
          },
          "response_format": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/TextFormat"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "model",
          "messages"
        ],
        "title": "ChatRequest"
      },
      "ChatText": {
        "properties": {
          "type": {
            "type": "string",
            "const": "text",
            "title": "Type"
          },
          "text": {
            "type": "string",
            "title": "Text"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "type",
          "text"
        ],
        "title": "ChatText"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "InputImage": {
        "properties": {
          "type": {
            "type": "string",
            "const": "input_image",
            "title": "Type"
          },
          "image_url": {
            "type": "string",
            "title": "Image Url",
            "description": "URL HTTPS accessible à OpenAI ou data URL base64 JPEG/PNG/WEBP/GIF. 10 Mio maximum par image intégrée ; 8 images et 16 Mio de JSON par requête."
          },
          "detail": {
            "type": "string",
            "enum": [
              "auto",
              "low",
              "high",
              "original"
            ],
            "title": "Detail",
            "default": "auto"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "type",
          "image_url"
        ],
        "title": "InputImage"
      },
      "InputText": {
        "properties": {
          "type": {
            "type": "string",
            "const": "input_text",
            "title": "Type"
          },
          "text": {
            "type": "string",
            "title": "Text"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "type",
          "text"
        ],
        "title": "InputText"
      },
      "Message": {
        "properties": {
          "role": {
            "type": "string",
            "enum": [
              "system",
              "developer",
              "user",
              "assistant"
