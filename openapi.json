          },
          "content": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "items": {
                  "oneOf": [
                    {
                      "$ref": "#/components/schemas/InputText"
                    },
                    {
                      "$ref": "#/components/schemas/InputImage"
                    }
                  ],
                  "discriminator": {
                    "propertyName": "type",
                    "mapping": {
                      "input_image": "#/components/schemas/InputImage",
                      "input_text": "#/components/schemas/InputText"
                    }
                  }
                },
                "type": "array"
              }
            ],
            "title": "Content"
          },
          "type": {
            "anyOf": [
              {
                "type": "string",
                "const": "message"
              },
              {
                "type": "null"
              }
            ],
            "title": "Type"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "role",
          "content"
        ],
        "title": "Message"
      },
      "Reasoning": {
        "properties": {
          "effort": {
            "type": "string",
            "enum": [
              "none",
              "minimal",
              "low",
              "medium",
              "high",
              "xhigh",
              "max"
            ],
            "title": "Effort"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "effort"
        ],
        "title": "Reasoning"
      },
      "ResponseRequest": {
        "properties": {
          "model": {
            "type": "string",
            "maxLength": 200,
            "minLength": 1,
            "title": "Model"
          },
          "input": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "items": {
                  "$ref": "#/components/schemas/Message"
                },
                "type": "array"
              }
            ],
            "title": "Input"
          },
          "instructions": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Instructions"
          },
          "stream": {
            "type": "boolean",
            "title": "Stream",
            "default": false
          },
          "store": {
            "type": "boolean",
            "const": false,
            "title": "Store",
            "default": false
          },
          "reasoning": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Reasoning"
              },
              {
                "type": "null"
              }
            ]
          },
          "temperature": {
            "anyOf": [
              {
                "anyOf": [
                  {
                    "type": "number"
                  },
                  {
                    "type": "integer"
                  }
                ],
                "ge": 0,
                "le": 2
              },
              {
                "type": "null"
              }
            ],
            "title": "Temperature"
          },
          "top_p": {
            "anyOf": [
              {
                "anyOf": [
                  {
                    "type": "number"
                  },
                  {
                    "type": "integer"
                  }
                ],
                "ge": 0,
                "le": 1
              },
              {
                "type": "null"
              }
            ],
            "title": "Top P"
          },
          "max_output_tokens": {
            "anyOf": [
              {
                "type": "integer",
                "maximum": 131072.0,
                "minimum": 1.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Max Output Tokens"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "model",
          "input"
        ],
